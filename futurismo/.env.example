# =================================================================
# CONFIGURACIÓN DE ENTORNO - FUTURISMO FRONTEND
# =================================================================
# Copiar este archivo a .env.local y configurar con valores reales
# NUNCA commitear archivos .env con datos reales

# =================================================================
# BACKEND API CONFIGURATION
# =================================================================
# URL base del API backend (sin trailing slash)
VITE_API_URL=https://api.futurismo.com/v1

# WebSocket URLs para tiempo real
VITE_WS_URL=wss://ws.futurismo.com
VITE_WS_BACKUP_URL=wss://ws-backup.futurismo.com
VITE_WS_FALLBACK_URL=wss://ws-fallback.futurismo.com

# =================================================================
# ENVIRONMENT CONFIGURATION
# =================================================================
# Entorno actual: development | staging | production
VITE_ENVIRONMENT=production

# Habilitar modo debug (solo development/staging)
VITE_DEBUG_MODE=false

# Habilitar WebSocket (false para modo offline)
VITE_ENABLE_WEBSOCKET=true

# Habilitar datos mock para desarrollo
VITE_ENABLE_MOCK_DATA=false

# =================================================================
# MAP CONFIGURATION
# =================================================================
# Coordenadas por defecto del mapa (formato: lat,lng)
VITE_MAP_DEFAULT_LAT=-13.5319
VITE_MAP_DEFAULT_LNG=-71.9675
VITE_MAP_DEFAULT_ZOOM=13

# Providers de mapas (separados por coma)
VITE_MAP_PROVIDERS=openstreetmap,cartodb,stamen

# =================================================================
# EXTERNAL SERVICES
# =================================================================
# Número de WhatsApp para consultas (incluir código país)
VITE_WHATSAPP_NUMBER=+51999888777

# Email de soporte
VITE_SUPPORT_EMAIL=soporte@futurismo.com

# URL del centro de ayuda
VITE_HELP_URL=https://help.futurismo.com

# =================================================================
# PERFORMANCE & CACHING
# =================================================================
# Intervalo de actualización del mapa en tiempo real (ms)
VITE_MAP_UPDATE_INTERVAL=5000

# Timeout para requests HTTP (ms)
VITE_REQUEST_TIMEOUT=30000

# Máximo número de reintentos para conexiones fallidas
VITE_MAX_RETRY_ATTEMPTS=3

# =================================================================
# FEATURES FLAGS
# =================================================================
# Habilitar notificaciones push
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# Habilitar modo offline
VITE_ENABLE_OFFLINE_MODE=true

# Habilitar métricas de performance
VITE_ENABLE_PERFORMANCE_METRICS=false

# Habilitar logging detallado
VITE_ENABLE_DETAILED_LOGGING=false

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
# Dominio permitido para CORS (solo si controlas el backend)
VITE_ALLOWED_DOMAIN=futurismo.com

# Tiempo de expiración de sesión (minutos)
VITE_SESSION_TIMEOUT=480

# =================================================================
# DEVELOPMENT OVERRIDES
# =================================================================
# Solo para desarrollo local - descomentar según necesites

# Backend local
# VITE_API_URL=http://localhost:3001/api
# VITE_WS_URL=ws://localhost:3001

# Datos mock habilitados
# VITE_ENABLE_MOCK_DATA=true

# Debug habilitado
# VITE_DEBUG_MODE=true

# Logging detallado
# VITE_ENABLE_DETAILED_LOGGING=true